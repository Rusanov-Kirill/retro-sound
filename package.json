{
  "name": "retro-sound",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "run-s electron-build dev-main",
    "dev-main": "concurrently \"vite\" \"wait-on http://localhost:5173 && electronmon .\"",
    "electron-build": "tsc -p tsconfig.electron.json",
    "lint": "eslint .",
    "pack": "electron-builder --dir",
    "build": "vite build",
    "dist": "electron-builder"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.retro.sound",
    "productName": "Retro Sound",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  },
  "dependencies": {
    "concurrently": "^9.2.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "sass": "^1.89.2",
    "wait-on": "^8.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0"
  }
}